# Application database. Keep real credentials in .env.local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/deal_flow_360_dev

# Better Auth email/password authentication. Generate a random secret of at least 32 bytes.
BETTER_AUTH_SECRET=replace-with-a-long-random-development-secret
BETTER_AUTH_URL=http://127.0.0.1:3000

# Resend transactional email. Leave unset until email delivery is exercised.
RESEND_API_KEY=
EMAIL_FROM="DealFlow360 <onboarding@resend.dev>"
# Optional safe provider-boundary destination for local demonstration.
EMAIL_TEST_RECIPIENT=delivered@resend.dev

# Local WebSocket listener: must be 101 higher than the application port.
REALTIME_PORT=3101
AUTOMATIC_BILLING=true

# All synthetic demo accounts use this locally supplied password (at least 12 characters).
DEMO_PASSWORD=replace-with-development-only-password
# UAT only: rendered in the browser to autofill the reviewer dropdown. Never use a real credential.
NEXT_PUBLIC_REVIEWER_PASSWORD=

# Browser test identity. Seed this user in the dedicated test database.
PLAYWRIGHT_USER_EMAIL=e2e-user@example.test
PLAYWRIGHT_USER_PASSWORD=replace-with-test-only-password

# Optional deterministic local credential seed. Use synthetic development-only values.
SEED_AUTH_NAME=Development User
SEED_AUTH_EMAIL=developer@example.test
SEED_AUTH_PASSWORD=replace-with-development-only-password
