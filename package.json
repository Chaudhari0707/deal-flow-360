{
  "name": "deal-flow-360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "bun run scripts/generate-auth-schema.ts",
    "build": "bun run scripts/run-build.ts",
    "build:rules": "bun run lint-rules/build-rules.ts",
    "check": "bun run check:quick && bun run test:unit && bun run test:regression && bun run test:integration && bun run build",
    "check:full": "bun run check && bun run test:e2e",
    "check:instructions": "bun run scripts/check-instructions.ts",
    "check:quick": "bun run fmt:check && bun run lint && bun run typecheck && bun run file-size && bun run check:instructions",
    "clean": "bun run scripts/clean-workspace.ts",
    "clean:all": "bun run scripts/clean-workspace.ts --dependencies --force",
    "db:check": "bun --bun x drizzle-kit check",
    "db:generate": "bun --bun x drizzle-kit generate",
    "db:migrate": "bun --bun x drizzle-kit migrate",
    "db:push": "bun run scripts/db-push.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "db:studio": "bun --bun x drizzle-kit studio",
    "db:test:migrate": "bun run scripts/db-test-command.ts migrate",
    "db:test:reset": "bun run scripts/db-test-reset.ts",
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "dev:setup": "bun run scripts/dev-setup.ts",
    "email:dev": "bun --bun x email dev --dir src/emails",
    "env:check": "bun run scripts/check-env.ts",
    "file-size": "bun run scripts/check-file-size.ts",
    "fmt": "bun --bun x oxfmt",
    "fmt:check": "bun --bun x oxfmt --check",
    "fresh": "bun run clean:all && bun install",
    "lint": "bun run build:rules && bun --bun x oxlint",
    "lint:fix": "bun run build:rules && bun --bun x oxlint --fix --fix-suggestions",
    "local": "bun run scripts/dev-local.ts",
    "local:check": "bun run scripts/dev-local.ts --check",
    "prepare": "bun --bun x husky",
    "realtime": "bun run scripts/realtime.ts",
    "shadcn": "bun --bun x shadcn",
    "start": "bun --bun next start",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:debug": "bun run scripts/run-e2e.ts --debug",
    "test:e2e:headed": "bun run scripts/run-e2e.ts --headed",
    "test:e2e:install": "bun --bun playwright install chromium",
    "test:e2e:ui": "bun run scripts/run-e2e.ts --ui",
    "test:integration": "bun run scripts/run-test-suite.ts integration",
    "test:regression": "bun run scripts/run-test-suite.ts regression",
    "test:unit": "bun run scripts/run-test-suite.ts unit",
    "typecheck": "bun --bun x tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/openapi": "1.4.16",
    "@react-email/components": "1.0.12",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "elysia": "1.4.30",
    "exceljs": "4.4.0",
    "lucide-react": "1.41.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "resend": "6.26.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "auth": "1.7.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react-email": "6.9.3",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,yml,yaml}": [
      "bun --bun x oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "bun --bun x oxlint --fix --fix-suggestions"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
